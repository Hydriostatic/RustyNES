{
  "format": 1,
  "id": "smb1-text-panel",
  "name": "Super Mario Bros. – text panel",
  "game": "Super Mario Bros. (World)",
  "version": "1.0",
  "author": "RustyNES Thor build (example, no game art)",
  "match": { "name_regex": "(?i)^super mario bros\\.?( \\(|\\.nes$)" },
  "theme": { "background": "#5C94FC", "panel": "#C84C0C", "text": "#FFFFFF", "label": "#FCBCB0", "accent": "#FCE0A8",
             "title_colors": ["#FCE0A8", "#FFFFFF"] },
  "screen": {
    "title": "World {world}-{stage}",
    "columns": 3,
    "tiles": [
      { "label": "Score", "value": "{score:06}" },
      { "label": "Coins", "value": "{coins:02}" },
      { "label": "Lives", "value": "{lives}" },
      { "label": "Time", "value": "{timer:03}" },
      { "label": "Power", "value": "{power}" },
      { "label": "Played", "value": "{time}" }
    ]
  },
  "values": {
    "lives_raw": { "type": "u8", "addr": "0x075A" },
    "lives": { "type": "u8", "addr": "0x075A", "add": 1 },
    "coins": { "type": "u8", "addr": "0x075E" },
    "world": { "type": "u8", "addr": "0x075F", "add": 1 },
    "stage": { "type": "u8", "addr": "0x075C", "add": 1 },
    "score": { "type": "digits", "addr": "0x07DD", "count": 6 },
    "timer": { "type": "digits", "addr": "0x07F8", "count": 3 },
    "power_raw": { "type": "u8", "addr": "0x0756" },
    "power": { "type": "lookup", "value": "power_raw", "table": { "0": "Small", "1": "Super", "2": "Fire" }, "default": "?" }
  }
}
